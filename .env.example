# Student Work Assistant - copy to .env (never commit .env). Everything is optional:
# a missing value only disables that feature; the offline demo always starts.
APP_MODE=demo
DATA_DIR=./local-data
DATABASE_PATH=./local-data/app.sqlite3
DISPLAY_TIMEZONE=Asia/Singapore
SAMPLE_DATA_DIR=D:/DSS5105-track4/AI项目数据源_去隐私
DESIGN_DIR=D:/DSS5105-track4/软件设计与AI工作流
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Model adapter (phase 4). Also requires the user to allow model processing in Settings.
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
ALLOW_MODEL_PROCESSING=false

# Real writes stay off unless BOTH this and the in-app setting are on, the account holds the
# write scope, APP_MODE=live, and the user confirms each proposal.
ENABLE_EXTERNAL_WRITES=false

# OAuth apps you register yourself (Google Cloud / Microsoft Entra). Redirect URIs must match exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/connections/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=organizations
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://127.0.0.1:8000/api/connections/microsoft/callback
